# Local environments and Python build/cache output
.venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Credentials and local editor settings
.env
.env.*
kaggle.json
.vscode/
.idea/
.DS_Store

# Local assistant instructions
/.github/instructions/

# Datasets, checkpoints and personal attendance records stay local.
/data/*
!/data/README.md
/artifacts/*
!/artifacts/.gitignore
*.pth
*.zip
*.tar
*.tar.gz


# Routine runs stay local; selected task evidence is retained separately.
/evidence/runs/

# Historical troubleshooting archives are local support files.
/evidence/archive/

# Complete training snapshots and large checkpoints are distributed on Drive.
/evidence/liveness/training-runs/

# Historical camera videos stay available locally and on Drive.
/evidence/liveness/camera-history/recordings/

# New local inference runs remain separate from selected submission evidence.
/evidence/liveness/local-inference/

# Full crop-audit databases are local regeneration caches; summaries are retained.
/evidence/liveness/crop-review/**/crops.sqlite
/evidence/liveness/crop-review/**/crops.sqlite-*

# Camera-trial source recordings remain local or on Drive.
*.[mM][pP]4

# Per-clip prediction caches are reproducible; selected summaries remain in Git.
/evidence/liveness/*/camera-evaluation/*/*/

# Current liveness submission evidence allowlist.
# Raw snapshots, resume outputs, logs and unselected repeats remain local/Drive.
/evidence/liveness/**
