# Local environments and Python build/cache output
.venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Credentials and local editor settings
.env
.env.*
kaggle.json
.vscode/
.idea/
.DS_Store

# Local assistant instructions
/.github/instructions/

# Datasets, checkpoints and personal attendance records stay local.
/data/*
!/data/README.md
/artifacts/*
